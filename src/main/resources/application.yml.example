spring:
  application:
    name: word-diary
  datasource:
    url: jdbc:mysql://localhost:3306/db-word-diary?useSSL=false&serverTimezone=UTC
    username: root
    password: your_password
    driver-class-name: com.mysql.cj.jdbc.Driver
  sql:
    init:
      mode: always
  # Spring AI 自动配置占位（实际调用走 sys_ai_provider + 数据库场景映射）
  ai:
    openai:
      api-key: ${OPENAI_API_KEY:sk-placeholder}
      base-url: ${AI_BASE_URL:https://api.deepseek.com}
      chat:
        options: {}

# 供应商接入点：仅作首次引导写入 sys_ai_provider（空密钥时补全）
# 运行时以数据库 / 管理后台为准；模型见 sys_ai_model，场景见 sys_ai_scene
app:
  ai:
    providers:
      deepseek:
        api-key: ${DEEPSEEK_API_KEY:sk-placeholder}
        base-url: https://api.deepseek.com
      aliyun:
        api-key: ${DASHSCOPE_API_KEY:sk-placeholder}
        # 不要带 /v1：Spring AI 会自动追加 /v1/chat/completions
        base-url: https://dashscope.aliyuncs.com/compatible-mode
      modelscope:
        api-key: ${MODELSCOPE_API_KEY:sk-placeholder}
        # 官方文档为 .../v1；代码会去掉尾部 /v1，再由 Spring AI 追加
        base-url: https://api-inference.modelscope.cn/v1
